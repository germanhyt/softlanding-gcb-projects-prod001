---
import VariantLayout from '../layouts/VariantLayout.astro';
import SemanticMap from '../components/SemanticMap.astro';
import Equipo from '../components/Equipo.astro';

const year = new Date().getFullYear();
---

<VariantLayout
  title="Grupo Cordillera Blanca SA"
  description="Portal de acceso a las unidades de negocio de Grupo Cordillera Blanca SA."
>
  <!-- Pista horizontal (desktop): Portada → Oficina → Mapa como slides -->
  <div id="hwrap">
    <div id="htrack">
      <!-- ═══ SLIDE 1: PORTADA / UNIDADES DE NEGOCIO ═══ -->
      <section id="pres-hero" class="pres-hero relative flex items-center justify-center overflow-hidden">
        <div id="pres-hero-content" class="relative z-10 mx-auto flex max-w-4xl flex-col items-center gap-6 px-6 py-10 text-center">
          <img
            src="/logo-gcb.jpg"
            alt="GCB — Grupo Cordillera Blanca SA"
            width="112"
            height="112"
            class="rounded-3xl block"
            style="box-shadow: 0 0 0 1px var(--color-variant-border), 0 24px 64px rgba(0,0,0,0.5);"
            fetchpriority="high"
          />

          <h1 class="variant-heading font-bold leading-none">
            <span class="block text-5xl sm:text-7xl" style="color: var(--color-variant-gold);">Grupo Cordillera Blanca</span>
            <span class="mt-3 block text-xl sm:text-2xl font-medium" style="color: var(--color-variant-text-muted);">
              Sociedad Anónima (S.A.)
            </span>
          </h1>

          <p class="max-w-2xl text-sm sm:text-lg" style="color: var(--color-variant-text-muted);">
            Tres espacios, una misma hospitalidad: Convexia, Refugio Gastronómico
            y Explanada Olguín. Desliza para recorrer la oficina virtual y el mapa
            de la operación.
          </p>
        </div>

        <!-- Scroll cue animado (en horizontal apunta a la derecha) -->
        <a
          href="#pres-equipo"
          id="pres-cue"
          class="pres-scroll-cue"
          aria-label="Deslizar hacia la oficina virtual"
        >
          <span class="text-[10px] uppercase tracking-widest" style="color: var(--color-variant-text-muted);">Scroll</span>
          <svg class="pres-scroll-chevron" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--color-variant-gold);">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </a>
      </section>

      <!-- ═══ SLIDE 2: OFICINA VIRTUAL / NUESTRO EQUIPO ═══ -->
      <section id="pres-equipo" class="pres-equipo relative py-4 sm:py-6" aria-label="Nuestro equipo">
        <div id="pres-equipo-inner" class="mx-auto w-full max-w-[1680px] px-4 sm:px-6 lg:px-8">
          <Equipo />
        </div>

        <a
          href="#pres-map"
          id="pres-cue-equipo"
          class="pres-scroll-cue pres-scroll-cue--next"
          aria-label="Continuar hacia el mapa"
        >
          <span class="text-[10px] uppercase tracking-widest" style="color: var(--color-variant-text-muted);">Mapa</span>
          <svg class="pres-scroll-chevron" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--color-variant-gold);">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </a>
      </section>

      <!-- ═══ SLIDE 3: MAPA SEMÁNTICO ═══ -->
      <section id="pres-map" class="pres-map relative py-4 sm:py-6">
        <div id="pres-map-inner" class="mx-auto w-full max-w-[1680px] px-4 sm:px-6 lg:px-8">
          <SemanticMap />
        </div>
      </section>
    </div>
  </div>

  <footer class="pres-footer">
    <p>© {year} Grupo Cordillera Blanca SA</p>
    <span aria-hidden="true">·</span>
    <nav aria-label="Vistas del portal">
      <a href="/variant">Variante 3D</a>
    </nav>
  </footer></VariantLayout
>

<style>
  /* ── Vertical (móvil / reduced-motion / sin JS): portada sticky y las
     secciones la cubren como páginas, en orden hero → oficina → mapa ── */
  .pres-hero {
    position: sticky;
    top: 0;
    height: 100svh;
    z-index: 1;
  }
  .pres-map,
  .pres-equipo {
    position: relative;
    z-index: 10;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background-color: var(--color-variant-bg);
    border-top: 1px solid var(--color-variant-border);
    box-shadow: 0 -24px 64px rgba(0, 0, 0, 0.55);
    padding-bottom: 3rem;
  }

  /* Snap suave por sección en apilado vertical: proximity, no secuestra. */
  @media (max-width: 1023.98px) {
    html {
      scroll-snap-type: y proximity;
    }
    #htrack > section {
      scroll-snap-align: start;
    }
  }

  /* ── Horizontal (desktop con motion): pista de 3 slides ── */
  @media (min-width: 1024px) {
    #hwrap {
      overflow: hidden;
    }
    #htrack {
      display: flex;
      width: max-content;
      height: 100svh;
    }
    #htrack > section {
      width: 100vw;
      height: 100svh;
      flex-shrink: 0;
    }
    .pres-hero {
      position: relative;
      overflow-y: auto;
    }
    .pres-map,
    .pres-equipo {
      min-height: 100svh;
      border-top: none;
      border-left: 1px solid var(--color-variant-border);
      box-shadow: -24px 0 64px rgba(0, 0, 0, 0.55);
      overflow-y: auto;
    }
    /* El cue apunta a la derecha en modo horizontal */
    #htrack .pres-scroll-cue svg {
      rotate: -90deg;
    }
  }

  .pres-scroll-cue {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    z-index: 10;
  }
  .pres-scroll-cue--next {
    bottom: 1rem;
  }
  .pres-scroll-chevron {
    animation: pres-cue-bounce 1.8s ease-in-out infinite;
  }
  @keyframes pres-cue-bounce {
    0%, 100% { transform: translateY(0); opacity: 0.55; }
    50%      { transform: translateY(8px); opacity: 1; }
  }
  .pres-footer {
    position: relative;
    z-index: 10;
    background-color: var(--color-variant-bg);
    border-top: 1px solid var(--color-variant-border);
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.35rem 0.5rem;
    padding: 0.55rem 1rem;
    font-size: 0.68rem;
    color: var(--color-variant-text-muted);
  }
  .pres-footer p {
    margin: 0;
  }
  .pres-footer nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .pres-footer a {
    color: var(--color-variant-gold);
    text-decoration: none;
  }
  .pres-footer a:hover {
    text-decoration: underline;
  }
  @media (prefers-reduced-motion: reduce) {
    .pres-scroll-chevron { animation: none; }
    html { scroll-behavior: auto; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wide = window.matchMedia('(min-width: 1024px)').matches;

  if (!reduced) {
    // Entrada de la portada al cargar (fade + rise escalonado)
    gsap.from('#pres-hero-content > *', {
      y: 28,
      opacity: 0,
      duration: 0.9,
      ease: 'power3.out',
      stagger: 0.09,
    });

    // Lenis: scroll mantecoso (autoRaf) + triggers sincronizados
    const { default: Lenis } = await import('lenis');
    const lenis = new Lenis({ autoRaf: true, lerp: 0.1 });
    lenis.on('scroll', ScrollTrigger.update);

    // Líneas del mapa: dibujado progresivo (helper compartido)
    const prepLines = () => {
      const lines = Array.from(
        document.querySelectorAll<SVGPathElement>('#pres-map .sem-line-main, #pres-map .sem-line-sub')
      );
      lines.forEach((line) => {
        try {
          const len = line.getTotalLength();
          line.style.strokeDasharray = `${len}`;
          line.style.strokeDashoffset = `${len}`;
        } catch {
          /* paths no medibles: quedan visibles sin animación */
        }
      });
      return lines.filter((l) => l.style.strokeDashoffset !== '');
    };

    if (wide) {
      // ── Slides horizontales: la pista se desplaza con pin + scrub.
      // Orden: hero (1) → oficina (2) → mapa (3). El snap por slide asienta
      // la vista en el slide más cercano al soltar (proximity: tolerante,
      // no secuestra el scroll; nada queda a mitad entre slides). ──
      const track = document.getElementById('htrack') as HTMLElement;
      const getX = () => Math.max(0, track.scrollWidth - window.innerWidth);
      const slideCount = track.querySelectorAll(':scope > section').length;
      const slide = gsap.to(track, {
        x: () => -getX(),
        ease: 'none',
        scrollTrigger: {
          trigger: '#hwrap',
          start: 'top top',
          end: () => `+=${getX()}`,
          pin: true,
          scrub: 1,
          snap: {
            snapTo: 1 / Math.max(1, slideCount - 1),
            duration: { min: 0.15, max: 0.6 },
            delay: 0.12,
            ease: 'power3.out',
          },
          invalidateOnRefresh: true,
        },
      });

      // El cue del hero salta al slide 2 (oficina); el cue intermedio
      // de la oficina salta al final del recorrido (slide 3, mapa).
      const scrollToProgress = (p: number) => {
        const st = slide.scrollTrigger;
        if (!st) return;
        lenis.scrollTo(st.start + (st.end - st.start) * p);
      };
      document.getElementById('pres-cue')?.addEventListener('click', (e: MouseEvent) => {
        e.preventDefault();
        scrollToProgress(0.5);
      });
      document.getElementById('pres-cue-equipo')?.addEventListener('click', (e: MouseEvent) => {
        e.preventDefault();
        lenis.scrollTo(slide.scrollTrigger!.end);
      });

      // Portada: se disuelve mientras sale por la izquierda
      gsap.to('#pres-hero-content', {
        xPercent: -6,
        opacity: 0.15,
        ease: 'none',
        scrollTrigger: {
          trigger: '#pres-hero',
          containerAnimation: slide,
          start: 'left left',
          end: 'right left',
          scrub: true,
        },
      });

      // Oficina (slide 2): entra con fade + desplazamiento sutil
      gsap.from('#pres-equipo-inner', {
        opacity: 0,
        x: 48,
        scale: 0.98,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '#pres-equipo',
          containerAnimation: slide,
          start: 'left 75%',
          toggleActions: 'play none none reverse',
        },
      });

      // Mapa (slide 3): entra con fade + desplazamiento sutil
      gsap.from('#pres-map-inner', {
        opacity: 0,
        x: 48,
        scale: 0.98,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '#pres-map',
          containerAnimation: slide,
          start: 'left 75%',
          toggleActions: 'play none none reverse',
        },
      });

      const drawable = prepLines();
      if (drawable.length > 0) {
        gsap.to(drawable, {
          strokeDashoffset: 0,
          duration: 1.4,
          ease: 'power2.out',
          stagger: 0.05,
          scrollTrigger: {
            trigger: '#pres-map',
            containerAnimation: slide,
            start: 'left 60%',
            toggleActions: 'play none none reverse',
          },
        });
      }
    } else {
      // ── Vertical (móvil): portada sticky + secciones que la cubren,
      // en orden hero → oficina → mapa ──
      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
        a.addEventListener('click', (e: MouseEvent) => {
          const id = a.getAttribute('href');
          const target = id && id.length > 1 ? document.querySelector(id) : null;
          if (target) {
            e.preventDefault();
            lenis.scrollTo(target as HTMLElement);
          }
        });
      });

      gsap.to('#pres-hero-content', {
        yPercent: -14,
        scale: 0.96,
        opacity: 0.1,
        ease: 'none',
        scrollTrigger: {
          trigger: '#pres-hero',
          start: 'top top',
          end: 'bottom top',
          scrub: 0.6,
        },
      });

      gsap.from('#pres-equipo-inner', {
        y: 90,
        opacity: 0,
        scale: 0.97,
        duration: 1.2,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '#pres-equipo',
          start: 'top 92%',
          toggleActions: 'play none none reverse',
        },
      });

      gsap.from('#pres-map-inner', {
        y: 90,
        opacity: 0,
        scale: 0.97,
        duration: 1.2,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '#pres-map',
          start: 'top 92%',
          toggleActions: 'play none none reverse',
        },
      });

      const drawable = prepLines();
      if (drawable.length > 0) {
        gsap.to(drawable, {
          strokeDashoffset: 0,
          duration: 1.4,
          ease: 'power2.out',
          stagger: 0.05,
          scrollTrigger: {
            trigger: '#pres-map',
            start: 'top 70%',
            toggleActions: 'play none none reverse',
          },
        });
      }
    }

    // Recalcular posiciones tras la carga (logo/fuentes mueven el layout)
    window.addEventListener('load', () => ScrollTrigger.refresh());
    if (document.fonts) {
      document.fonts.ready.then(() => ScrollTrigger.refresh());
    }
  }
</script>
