---
import { planetDefs } from '../data/projects.ts';
import { icons } from '../data/icons.ts';
import { MAP_CENTER, branchPositions, leafPositions } from '../data/map-layout.ts';

/* ── Estructura de Datos para el Mapa Semántico Corporativo ── */
interface MapLeaf {
  id: string;
  name: string;
  sub: string;
  desc: string;
  href: string;
  domain: string;
  icon: string;
  tag: string;
  x: number;
  y: number;
  badge: string;
}

interface MapBranch {
  id: string;
  title: string;
  desc: string;
  category: string;
  x: number;
  y: number;
  accent: string;
  leaves: MapLeaf[];
}

/* Coordenadas en un lienzo expandido de 1440 × 940.
   El layout vive en src/data/map-layout.ts (ver DESIGN.md). */
const CX = MAP_CENTER.x;
const CY = MAP_CENTER.y;

/* Semitamaños (ancho/alto / 2 + margen) para recortar los conectores al ras
   de cada nodo: la línea llega al borde, nunca traspasa la tarjeta. */
const HUB_HALF = { hw: 165, hh: 80 };
const BRANCH_HALF = { hw: 105, hh: 55 };
const LEAF_HALF = { hw: 118, hh: 80 };

/** Punto sobre el borde de una elipse (cx,cy,hw,hh) en la dirección (dx,dy). */
function edgePoint(
  cx: number, cy: number, hw: number, hh: number,
  dx: number, dy: number, gap = 10,
): { x: number; y: number } {
  const len = Math.hypot(dx, dy) || 1;
  const ux = dx / len;
  const uy = dy / len;
  const t = 1 / Math.sqrt((ux / hw) ** 2 + (uy / hh) ** 2) + gap;
  return { x: cx + ux * t, y: cy + uy * t };
}

/* Layout del lienzo: lo único propio del mapa son las coordenadas x/y
   (importadas de map-layout.ts). Todo el contenido (nombre, desc, URL,
   badge, tag, domain, icono) viene de src/data/projects.ts. */
const leafLayout = leafPositions;

const branchLeafIds: Record<string, string[]> = {
  'b-refugio': ['p-proc', 'p-del', 'p-com', 'p-docgcb'],
  'b-channels': ['p-kiosk', 'p-runner', 'p-agenda'],
  'b-bosque': ['p-bosque', 'p-bosque-adm'],
  'b-ai': ['p-ai'],
  'b-sisa': ['p-sisa', 'p-sisa-reg'],
  'b-parking': ['p-est'],
  'b-finanzas': ['p-conc'],
};

function leafFromProject(id: string): MapLeaf {
  const p = planetDefs.find((d) => d.id === id)!;
  const pos = leafLayout[id]!;
  return {
    id: p.id,
    name: p.label,
    sub: p.full,
    desc: p.desc,
    href: p.href,
    domain: p.domain ?? '',
    icon: p.icon,
    tag: p.tag ?? '',
    badge: p.badge ?? '',
    x: pos.x,
    y: pos.y,
  };
}

const branches: MapBranch[] = [
  {
    id: 'b-refugio',
    title: 'Refugio Data',
    desc: 'Operaciones & Gestión Core',
    category: 'Analítica Operativa',
    ...branchPositions['b-refugio'],
    accent: '#C9A84C',
    leaves: branchLeafIds['b-refugio']!.map(leafFromProject),
  },
  {
    id: 'b-channels',
    title: 'Canales de Venta',
    desc: 'Punto de Venta & Despacho',
    category: 'Canales',
    ...branchPositions['b-channels'],
    accent: '#3CC9A4',
    leaves: branchLeafIds['b-channels']!.map(leafFromProject),
  },
  {
    id: 'b-bosque',
    title: 'Bosque Mágico',
    desc: 'Fiestas & Administración',
    category: 'Negocio',
    ...branchPositions['b-bosque'],
    accent: '#FF8C42',
    leaves: branchLeafIds['b-bosque']!.map(leafFromProject),
  },
  {
    id: 'b-ai',
    title: 'Inteligencia de Datos',
    desc: 'Modelos de Lenguaje & Análisis',
    category: 'Analítica Avanzada',
    ...branchPositions['b-ai'],
    accent: '#4A9EFF',
    leaves: branchLeafIds['b-ai']!.map(leafFromProject),
  },
  {
    id: 'b-sisa',
    title: 'SISA Reservas',
    desc: 'Reservas & Registro',
    category: 'Reservas',
    ...branchPositions['b-sisa'],
    accent: '#FF6B8E',
    leaves: branchLeafIds['b-sisa']!.map(leafFromProject),
  },
  {
    id: 'b-parking',
    title: 'Parking',
    desc: 'Control de acceso & Aforo',
    category: 'Operaciones',
    ...branchPositions['b-parking'],
    accent: '#4A7A5A',
    leaves: branchLeafIds['b-parking']!.map(leafFromProject),
  },
  {
    id: 'b-finanzas',
    title: 'Finanzas',
    desc: 'Conciliación & Auditoría',
    category: 'Finanzas',
    ...branchPositions['b-finanzas'],
    accent: '#FF6B8E',
    leaves: branchLeafIds['b-finanzas']!.map(leafFromProject),
  },
];

const f1 = (n: number) => +n.toFixed(1);

/* Conectores recortados al borde de cada nodo (nunca traspasan tarjetas) */
interface LineDef {
  id: string;
  d: string;
  accent?: string;
  parent?: string;
}

const level1Lines: LineDef[] = branches.map((b) => {
  const p1 = edgePoint(CX, CY, HUB_HALF.hw, HUB_HALF.hh, b.x - CX, b.y - CY);
  const p2 = edgePoint(b.x, b.y, BRANCH_HALF.hw, BRANCH_HALF.hh, CX - b.x, CY - b.y);
  return {
    id: b.id,
    d: `M ${f1(p1.x)} ${f1(p1.y)} L ${f1(p2.x)} ${f1(p2.y)}`,
  };
});

const level2Lines: LineDef[] = branches.flatMap((b) =>
  b.leaves.map((leaf) => {
    const dx = leaf.x - b.x;
    const dy = leaf.y - b.y;
    const s = edgePoint(b.x, b.y, BRANCH_HALF.hw, BRANCH_HALF.hh, dx, dy);
    const e = edgePoint(leaf.x, leaf.y, LEAF_HALF.hw, LEAF_HALF.hh, -dx, -dy);
    const mx = e.x - s.x;
    return {
      id: leaf.id,
      d: `M ${f1(s.x)} ${f1(s.y)} C ${f1(s.x + mx * 0.55)} ${f1(s.y)}, ${f1(e.x - mx * 0.55)} ${f1(e.y)}, ${f1(e.x)} ${f1(e.y)}`,
      accent: b.accent,
      parent: b.id,
    };
  }),
);
---

<div class="sem-container" id="semantic-map-root">
  <!-- ════════════════ LAYOUT: SIDEBAR + LIENZO FULL-WIDTH ════════════════ -->
  <div class="sem-layout">
  <!-- ── Sidebar de filtros (izquierda en desktop, arriba en móvil) ── -->
  <aside class="sem-sidebar" aria-label="Filtros del mapa">
    <p class="sem-side-title">Filtrar</p>
    <!-- Buscador Integrado en el Mapa -->
    <div class="sem-search">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input
        type="text"
        id="sem-search-input"
        class="sem-search-input"
        placeholder="Filtrar sistemas o presiona '/'..."
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="sem-kbd">/</kbd>
      <button id="sem-clear-search" class="sem-clear-btn" style="display: none;" aria-label="Limpiar">✕</button>
    </div>

    <!-- Filtros de Ramas / Pilares -->
    <p class="sem-side-title">Pilares</p>
    <div class="sem-pills">
      <button class="sem-pill is-active" data-branch="all">Todas las ramas</button>
      <button class="sem-pill" data-branch="b-refugio">Refugio Data</button>
      <button class="sem-pill" data-branch="b-channels">Canales de Venta</button>
      <button class="sem-pill" data-branch="b-bosque">Bosque Mágico</button>
      <button class="sem-pill" data-branch="b-ai">Inteligencia AI</button>
      <button class="sem-pill" data-branch="b-sisa">SISA Reservas</button>
      <button class="sem-pill" data-branch="b-parking">Parking</button>
      <button class="sem-pill" data-branch="b-finanzas">Finanzas</button>
    </div>

    <!-- Contador de Sistemas -->
    <div class="sem-status-box">
      <span class="sem-dot-live"></span>
      <span id="sem-count-display">{planetDefs.length} / {planetDefs.length} Sistemas Conectados</span>
    </div>
    <div class="sem-side-actions">
      <button id="sem-reset-layout" class="sem-reset-btn" title="Restablecer posiciones del mapa base" aria-label="Restablecer posiciones del mapa">
        Restablecer
      </button>
      <button id="sem-save-layout" class="sem-reset-btn" title="Guardar el layout actual en src/data/map-layout.ts (dev) o copiarlo si no hay servidor" aria-label="Guardar layout actual en el JSON del proyecto">
        Guardar layout
      </button>
    </div>
  </aside>

  <!-- ════════════════ LIENZO INTERACTIVO (DESKTOP) ════════════════ -->
  <div class="sem-board-wrapper" id="sem-board-wrapper">
    <div class="sem-board" id="sem-board">
      <svg class="sem-svg" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid meet">
        <defs>
          <!-- Halo ambiental radial (orgánico, sin grilla) -->
          <radialGradient id="sem-ambient" cx="50%" cy="50%" r="65%">
            <stop offset="0%" stop-color="#C9A84C" stop-opacity="0.08" />
            <stop offset="55%" stop-color="#C9A84C" stop-opacity="0.02" />
            <stop offset="100%" stop-color="#C9A84C" stop-opacity="0" />
          </radialGradient>
        </defs>

        <rect width="1600" height="1000" fill="url(#sem-ambient)" />

        <!-- ── LÍNEAS NIVEL 1: CENTRO -> PILARES (al ras de cada nodo) ── -->
        {level1Lines.map((l) => (
          <g class="path-group" id={`group-line-${l.id}`}>
            <!-- Línea base -->
            <path
              d={l.d}
              class="sem-line-main"
              id={`line-${l.id}`}
            />
            <!-- Línea animada de pulso de datos -->
            <path
              d={l.d}
              class="sem-line-pulse"
            />
          </g>
        ))}

        <!-- ── LÍNEAS NIVEL 2: PILARES -> SISTEMAS (curvas en S con el color del pilar) ── -->
        {level2Lines.map((l) => (
          <g class="path-group" id={`group-line-${l.id}`}>
            <path
              d={l.d}
              class="sem-line-sub"
              stroke={l.accent}
              id={`line-${l.id}`}
              data-parent={`line-${l.parent}`}
            />
          </g>
        ))}
      </svg>

      <!-- ════ NODO 1: EMPRESA CENTRAL ════ -->
      <div class="sem-node sem-core" style={`left:${CX}px; top:${CY}px;`} id="node-center-holding">
        <div class="sem-core-box">
          <div class="sem-core-top">
            <img class="sem-core-logo" src="/logo-gcb.jpg" alt="GCB — Grupo Cordillera Blanca SA" width="36" height="36" loading="lazy" />
            <span class="sem-core-badge">HOLDING</span>
          </div>
          <div class="sem-core-info">
            <span class="sem-core-eyebrow">EMPRESA MATRIZ</span>
            <h1 class="sem-core-title">Grupo Cordillera Blanca S.A.</h1>
            <p class="sem-core-desc">Centro Neurálgico & Gobernanza de Sistemas</p>
          </div>
        </div>
      </div>

      <!-- ════ NODOS 2: PILARES ESTRATÉGICOS (RAMAS) ════ -->
      {branches.map(b => (
        <div
          class="sem-node sem-branch"
          style={`left:${b.x}px; top:${b.y}px;`}
          id={b.id}
          data-branch-id={b.id}
        >
          <div class="sem-branch-box" style={`border-top: 3px solid ${b.accent};`}>
            <span class="sem-branch-cat">{b.category}</span>
            <h2 class="sem-branch-title">{b.title}</h2>
            <span class="sem-branch-meta">{b.leaves.length} aplicaciones conectadas</span>
          </div>
        </div>
      ))}

      <!-- ════ NODOS 3: SISTEMAS / PLATAFORMAS (HOJAS) ════ -->
      {branches.flatMap(b => b.leaves.map(leaf => (
        <a
          href={leaf.href}
          target="_blank"
          rel="noopener noreferrer"
          class="sem-node sem-leaf"
          style={`left:${leaf.x}px; top:${leaf.y}px; --leaf-accent:${b.accent};`}
          id={leaf.id}
          data-branch={b.id}
          data-keywords={`${leaf.name} ${leaf.sub} ${leaf.desc} ${leaf.domain} ${leaf.tag} ${leaf.badge}`.toLowerCase()}
        >
          <div class="sem-leaf-box">
            <div class="sem-leaf-head">
              <div class="sem-leaf-ico" set:html={icons[leaf.icon]} />
              <div class="sem-leaf-badges">
                <span class="sem-leaf-tag">{leaf.tag}</span>
                <span class="sem-leaf-badge">{leaf.badge}</span>
              </div>
            </div>

            <div class="sem-leaf-body">
              <div class="sem-leaf-name-row">
                <h3 class="sem-leaf-name">{leaf.name}</h3>
                <span class="sem-leaf-arrow" aria-hidden="true">↗</span>
              </div>
              <p class="sem-leaf-desc">{leaf.desc}</p>
            </div>

            <div class="sem-leaf-foot">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <span>{leaf.domain}</span>
            </div>
          </div>
        </a>
      )))}
    </div>
  </div>
  </div><!-- /sem-layout -->

  <!-- ════════════════ VISTA MÓVIL (ÁRBOL SEMÁNTICO EN CASCADA) ════════════════ -->
  <div class="sem-mobile-view">
    <div class="sem-mob-core">
      <div class="sem-mob-monogram">GCB</div>
      <div>
        <span class="sem-mob-kicker">MATRIZ EMPRESARIAL</span>
        <h2 class="sem-mob-h2">Grupo Cordillera Blanca S.A.</h2>
        <span class="sem-mob-meta">{planetDefs.length} Sistemas y Módulos Activos</span>
      </div>
    </div>

    <div class="sem-mob-tree">
      {branches.map(b => (
        <details class="sem-mob-branch" open>
          <summary class="sem-mob-branch-sum" style={`border-left: 3px solid ${b.accent};`}>
            <div>
              <span class="sem-mob-branch-cat">{b.category}</span>
              <h3 class="sem-mob-branch-title">{b.title}</h3>
            </div>
            <span class="sem-mob-branch-count">{b.leaves.length}</span>
          </summary>

          <div class="sem-mob-leaves">
            {b.leaves.map(leaf => (
              <a href={leaf.href} target="_blank" rel="noopener noreferrer" class="sem-mob-leaf">
                <div class="sem-mob-leaf-ico" set:html={icons[leaf.icon]} />
                <div class="sem-mob-leaf-info">
                  <div class="sem-mob-leaf-top">
                    <span class="sem-mob-leaf-title">{leaf.name}</span>
                    <span class="sem-mob-leaf-tag">{leaf.badge}</span>
                  </div>
                  <p class="sem-mob-leaf-desc">{leaf.desc}</p>
                  <span class="sem-mob-leaf-url">{leaf.domain}</span>
                </div>
                <span class="sem-mob-leaf-arr">↗</span>
              </a>
            ))}
          </div>
        </details>
      ))}
    </div>
  </div>
</div>

<style>
/* ── Estructura Base ───────────────────────────────── */
.sem-container {
  width: 100%;
  margin: 0 auto;
  padding: 1.25rem clamp(1rem, 3vw, 2.5rem) 3.5rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

/* ── Layout: sidebar izquierda + lienzo full-width ─── */
.sem-layout {
  display: flex;
  gap: 1.25rem;
  align-items: flex-start;
  width: 100%;
}

.sem-sidebar {
  width: 272px;
  flex-shrink: 0;
  position: sticky;
  top: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 1rem;
}

.sem-side-title {
  font-family: var(--fb);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted);
  margin: 0;
}

.sem-side-actions {
  display: flex;
  gap: 0.4rem;
}

.sem-side-actions .sem-reset-btn {
  flex: 1;
}

.sem-board-wrapper {
  flex: 1 1 auto;
  min-width: 0;
}

.sem-search {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
}

.sem-search svg {
  position: absolute;
  left: 0.8rem;
  color: var(--muted);
  pointer-events: none;
}

.sem-search-input {
  width: 100%;
  height: 36px;
  padding: 0 2.5rem 0 2.3rem;
  font-family: var(--fb);
  font-size: max(16px, 0.8rem); /* mobile-native: <16px hace zoom en iOS al enfocar */
  color: var(--text);
  background-color: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 6px;
  outline: none;
  transition: border-color 0.15s ease;
}

.sem-search-input:focus {
  border-color: var(--gold);
}

.sem-kbd {
  position: absolute;
  right: 0.75rem;
  font-family: monospace;
  font-size: 0.68rem;
  color: var(--muted);
  background: var(--surface);
  border: 1px solid var(--border);
  padding: 0.1rem 0.35rem;
  border-radius: 3px;
  pointer-events: none;
}

.sem-clear-btn {
  position: absolute;
  right: 0.65rem;
  background: none;
  border: none;
  color: var(--muted);
  cursor: pointer;
  font-size: 0.75rem;
}

.sem-pills {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 0.35rem;
}

.sem-pill {
  font-family: var(--fb);
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--muted);
  background-color: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 0.45rem 0.75rem;
  cursor: pointer;
  text-align: left;
  transition: background-color 0.15s ease-out, color 0.15s ease-out, border-color 0.15s ease-out, transform 0.15s ease-out;
}

.sem-pill:hover {
  color: var(--text);
  border-color: var(--gold-border);
}

.sem-pill:active {
  transform: scale(0.98);
}

.sem-pill.is-active {
  background-color: var(--text);
  color: var(--bg);
  border-color: var(--text);
  font-weight: 600;
}

.sem-status-box {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  font-family: var(--fb);
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--muted);
  border-top: 1px solid var(--border);
  padding-top: 0.85rem;
}

.sem-dot-live {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background-color: #15803D;
}

.sem-reset-btn {
  font-family: var(--fb);
  font-size: 0.68rem;
  font-weight: 600;
  color: var(--muted);
  background: transparent;
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 0.2rem 0.55rem;
  cursor: pointer;
  transition: color 0.15s ease-out, border-color 0.15s ease-out;
}
.sem-reset-btn:hover {
  color: var(--gold);
  border-color: var(--gold);
}
.sem-reset-btn:active {
  transform: scale(0.96);
}

/* ── Lienzo SVG de Escritorio ──────────────────────── */
.sem-board-wrapper {
  position: relative;
  width: 100%;
  height: 1000px;
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
}

.sem-board {
  position: relative;
  width: 1600px;
  height: 1000px;
  transform-origin: top left;
}

.sem-svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

/* Líneas de Conexión */
.sem-line-main {
  stroke: var(--gold);
  stroke-width: 3;
  stroke-opacity: 0.9;
  stroke-linecap: round;
  fill: none;
}

.sem-line-pulse {
  stroke: var(--gold);
  stroke-width: 3;
  stroke-dasharray: 8 28;
  stroke-linecap: round;
  fill: none;
  animation: pulseMove 3s linear infinite;
  opacity: 0.9;
}

@keyframes pulseMove {
  from { stroke-dashoffset: 72; }
  to   { stroke-dashoffset: 0; }
}

.sem-line-sub {
  /* El color lo pone cada path vía atributo stroke (= accent del pilar) */
  stroke-width: 2.5;
  stroke-opacity: 0.8;
  stroke-linecap: round;
  fill: none;
  transition: stroke-width 0.2s ease, stroke-opacity 0.2s ease;
}

.sem-line-sub.is-highlighted {
  stroke: var(--gold) !important;
  stroke-width: 2.5px !important;
  stroke-opacity: 1 !important;
}

/* Nodos Base */
.sem-node {
  position: absolute;
  transform: translate(-50%, -50%);
  z-index: 10;
  transition: opacity 0.2s ease, transform 0.2s ease;
  cursor: grab;
  touch-action: none;
}

.sem-node.is-dragging {
  cursor: grabbing;
  z-index: 30;
  transition: none;
}

.sem-node.is-dimmed {
  opacity: 0.25;
  pointer-events: none;
}

/* ── 1. NODO CENTRAL: GRUPO CORDILLERA BLANCA ──────── */
.sem-core {
  min-width: 300px;
  cursor: default;
}

.sem-core-box {
  background-color: var(--card-bg);
  border: 2px solid var(--gold);
  border-radius: 16px;
  padding: 1.2rem 1.6rem;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
}

.sem-core-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sem-core-logo {
  width: 36px;
  height: 36px;
  border-radius: 8px;
