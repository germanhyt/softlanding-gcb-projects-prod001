<!-- ════════════════ SCRIPT DE INTERACTIVIDAD AVANZADA ════════════════ -->
<script>
  function setupSemanticMap() {
    const searchInput = document.getElementById('sem-search-input') as HTMLInputElement | null;
    const clearSearchBtn = document.getElementById('sem-clear-search') as HTMLButtonElement | null;
    const pills = document.querySelectorAll('.sem-pill');
    const leafNodes = document.querySelectorAll('.sem-leaf') as NodeListOf<HTMLElement>;
    const branchNodes = document.querySelectorAll('.sem-branch') as NodeListOf<HTMLElement>;
    const counterDisplay = document.getElementById('sem-count-display');

    let activeBranch = 'all';
    let query = '';

    function updateMapFilter() {
      let visibleCount = 0;

      leafNodes.forEach(node => {
        const branchId = node.getAttribute('data-branch') || '';
        const keywords = node.getAttribute('data-keywords') || '';
        const id = node.getAttribute('id') || '';
        const lineEl = document.getElementById(`line-${id}`);

        const matchBranch = activeBranch === 'all' || branchId === activeBranch;
        const matchSearch = !query || keywords.includes(query);

        if (matchBranch && matchSearch) {
          node.classList.remove('is-dimmed');
          if (lineEl) lineEl.style.opacity = '0.85';
          visibleCount++;
        } else {
          node.classList.add('is-dimmed');
          if (lineEl) lineEl.style.opacity = '0.08';
        }
      });

      // Actualizar ramas intermedias
      branchNodes.forEach(b => {
        const bId = b.getAttribute('data-branch-id') || '';
        const mainLine = document.getElementById(`line-${bId}`);
        const isActive = activeBranch === 'all' || activeBranch === bId;

        if (isActive) {
          b.classList.remove('is-dimmed');
          if (mainLine) mainLine.style.opacity = '0.45';
        } else {
          b.classList.add('is-dimmed');
          if (mainLine) mainLine.style.opacity = '0.08';
        }
      });

      if (counterDisplay) {
        counterDisplay.textContent = `${visibleCount} / ${leafNodes.length} Sistemas Conectados`;
      }
    }

    // Búsqueda en vivo
    searchInput?.addEventListener('input', (e) => {
      query = (e.target as HTMLInputElement).value.trim().toLowerCase();
      if (clearSearchBtn) {
        clearSearchBtn.style.display = query ? 'block' : 'none';
      }
      updateMapFilter();
    });

    clearSearchBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        query = '';
        clearSearchBtn.style.display = 'none';
        searchInput.focus();
        updateMapFilter();
      }
    });

    // Atajo '/'
    window.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== searchInput) {
        e.preventDefault();
        searchInput?.focus();
        searchInput?.select();
      }
    });

    // Filtro por ramas
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('is-active'));
        pill.classList.add('is-active');
        activeBranch = pill.getAttribute('data-branch') || 'all';
        updateMapFilter();
      });
    });

    // Click directo en nodos de rama para filtrar
    branchNodes.forEach(b => {
      b.addEventListener('click', () => {
        const bId = b.getAttribute('data-branch-id') || 'all';
        activeBranch = activeBranch === bId ? 'all' : bId;

        pills.forEach(p => {
          const target = p.getAttribute('data-branch');
          p.classList.toggle('is-active', target === activeBranch);
        });

        updateMapFilter();
      });
    });

    // Hover sobre nodos hoja para iluminar líneas
    leafNodes.forEach(leaf => {
      const id = leaf.getAttribute('id');
      const branchId = leaf.getAttribute('data-branch');
      const subLine = id ? document.getElementById(`line-${id}`) : null;
      const mainLine = branchId ? document.getElementById(`line-${branchId}`) : null;
      const branchNode = branchId ? document.getElementById(branchId) : null;

      leaf.addEventListener('mouseenter', () => {
        if (subLine) subLine.classList.add('is-highlighted');
        if (mainLine) {
          mainLine.style.strokeOpacity = '1';
          mainLine.style.strokeWidth = '2.5px';
        }
        if (branchNode) {
          branchNode.style.transform = 'translate(-50%, -54%)';
        }
      });

      leaf.addEventListener('mouseleave', () => {
        if (subLine) subLine.classList.remove('is-highlighted');
        if (mainLine) {
          mainLine.style.strokeOpacity = '';
          mainLine.style.strokeWidth = '';
        }
        if (branchNode) {
          branchNode.style.transform = '';
        }
      });
    });
  }

  setupSemanticMap();
  document.addEventListener('astro:page-load', setupSemanticMap);
  /* ── Fit del tablero: escala 1440×940 al ancho real para que las
     líneas SVG y las tarjetas px siempre coincidan. Además se limita por
     alto (74svh) para que la sección cuadre en pantalla, centrando el
     lienzo cuando sobra ancho. ── */
  function fitBoard() {
    const wrapper = document.getElementById('sem-board-wrapper');
    const board = document.getElementById('sem-board');
    if (!wrapper || !board) return;
    const w = wrapper.clientWidth;
    if (!w) return;
    const s = Math.min(w / 1600, (window.innerHeight * 0.74) / 1000, 1);
    board.style.transform = `scale(${s})`;
    board.style.marginLeft = `${Math.max(0, (w - 1600 * s) / 2)}px`;
    wrapper.style.height = `${Math.round(1000 * s)}px`;
  }
  const boardWrapper = document.getElementById('sem-board-wrapper');
  if (boardWrapper && typeof ResizeObserver !== 'undefined') {
    new ResizeObserver(fitBoard).observe(boardWrapper);
  }
  fitBoard();
  window.addEventListener('load', fitBoard);
  document.addEventListener('astro:page-load', fitBoard);
</script>

<script>
  /* ── Layout persistente: ramas y hojas arrastrables, hub fijo como ancla.
     Las coordenadas base son las renderizadas por el servidor (mapa base);
     cualquier cambio se guarda en localStorage y sobrevive recargas. ── */
  (function initMapDrag() {
    const board = document.getElementById('sem-board');
    if (!board || board.dataset.dragReady === '1') return;
    board.dataset.dragReady = '1';

    const KEY = 'gcb-map-layout-v1';
    const HUB_ID = 'node-center-holding';
    const HUB_HALF = { hw: 165, hh: 80 };
    const BRANCH_HALF = { hw: 105, hh: 55 };
    const LEAF_HALF = { hw: 118, hh: 80 };

    interface DragNode {
      el: HTMLElement;
      kind: 'hub' | 'branch' | 'leaf';
      branchId?: string;
      x: number;
      y: number;
    }

    const px = (v: string) => parseFloat(v) || 0;
    const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
    const f1 = (n: number) => +n.toFixed(1);

    const nodes = new Map<string, DragNode>();
    const hubEl = document.getElementById(HUB_ID) as HTMLElement | null;
    if (hubEl) {
      nodes.set(HUB_ID, { el: hubEl, kind: 'hub', x: px(hubEl.style.left), y: px(hubEl.style.top) });
    }
    board.querySelectorAll<HTMLElement>('.sem-branch').forEach((el) => {
      nodes.set(el.id, { el, kind: 'branch', x: px(el.style.left), y: px(el.style.top) });
    });
    board.querySelectorAll<HTMLElement>('.sem-leaf').forEach((el) => {
      nodes.set(el.id, {
        el,
        kind: 'leaf',
        branchId: el.dataset.branch || '',
        x: px(el.style.left),
        y: px(el.style.top),
      });
    });

    const defaults: Record<string, { x: number; y: number }> = {};
    nodes.forEach((n, id) => {
      defaults[id] = { x: n.x, y: n.y };
    });

    function edgePoint(
      cx: number, cy: number, hw: number, hh: number,
      dx: number, dy: number, gap = 10,
    ) {
      const len = Math.hypot(dx, dy) || 1;
      const ux = dx / len;
      const uy = dy / len;
      const t = 1 / Math.sqrt((ux / hw) ** 2 + (uy / hh) ** 2) + gap;
      return { x: cx + ux * t, y: cy + uy * t };
    }

    function setPath(id: string, d: string) {
      const p = document.getElementById(`line-${id}`);
      if (p) p.setAttribute('d', d);
      const g = document.getElementById(`group-line-${id}`);
      const pulse = g ? g.querySelector('.sem-line-pulse') : null;
      if (pulse) pulse.setAttribute('d', d);
    }

    function layoutLeaf(m: DragNode) {
      const b = m.branchId ? nodes.get(m.branchId) : undefined;
      if (!b) return;
      const dx = m.x - b.x;
      const dy = m.y - b.y;
      const s = edgePoint(b.x, b.y, BRANCH_HALF.hw, BRANCH_HALF.hh, dx, dy);
      const e = edgePoint(m.x, m.y, LEAF_HALF.hw, LEAF_HALF.hh, -dx, -dy);
      const mx = e.x - s.x;
      setPath(
        m.el.id,
        `M ${f1(s.x)} ${f1(s.y)} C ${f1(s.x + mx * 0.55)} ${f1(s.y)}, ${f1(e.x - mx * 0.55)} ${f1(e.y)}, ${f1(e.x)} ${f1(e.y)}`,
      );
    }

    function layoutNode(id: string) {
      const n = nodes.get(id);
      if (!n) return;
      n.el.style.left = `${n.x}px`;
      n.el.style.top = `${n.y}px`;
      const hub = nodes.get(HUB_ID);
      if (n.kind === 'branch' && hub) {
        const p1 = edgePoint(hub.x, hub.y, HUB_HALF.hw, HUB_HALF.hh, n.x - hub.x, n.y - hub.y);
        const p2 = edgePoint(n.x, n.y, BRANCH_HALF.hw, BRANCH_HALF.hh, hub.x - n.x, hub.y - n.y);
        setPath(id, `M ${f1(p1.x)} ${f1(p1.y)} L ${f1(p2.x)} ${f1(p2.y)}`);
        nodes.forEach((m) => {
          if (m.kind === 'leaf' && m.branchId === id) layoutLeaf(m);
        });
      } else if (n.kind === 'leaf') {
        layoutLeaf(n);
      }
    }

    // Aplicar layout guardado (si existe) sobre el mapa base
    try {
      const saved = JSON.parse(localStorage.getItem(KEY) || '{}') as Record<string, { x: number; y: number }>;
      Object.entries(saved).forEach(([id, p]) => {
        const n = nodes.get(id);
        if (n && n.kind !== 'hub' && Number.isFinite(p?.x) && Number.isFinite(p?.y)) {
          n.x = clamp(p.x, 60, 1540);
          n.y = clamp(p.y, 40, 960);
        }
      });
    } catch {
      /* sin layout guardado: se usa el mapa base */
    }
    nodes.forEach((n, id) => {
      if (n.kind === 'branch') layoutNode(id);
    });

    function boardScale() {
      const m = board!.style.transform.match(/scale\(([\d.]+)\)/);
      return m ? parseFloat(m[1]!) || 1 : 1;
    }

    interface DragState {
      id: string;
      el: HTMLElement;
      startX: number;
      startY: number;
      origX: number;
      origY: number;
      moved: boolean;
    }
    let drag: DragState | null = null;

    board.addEventListener('pointerdown', (e: PointerEvent) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      const target = e.target as Element | null;
      const nodeEl = target?.closest?.('.sem-node') as HTMLElement | null;
      if (!nodeEl || !nodes.has(nodeEl.id) || nodeEl.id === HUB_ID) return;
      const n = nodes.get(nodeEl.id)!;
      drag = {
        id: nodeEl.id,
        el: nodeEl,
        startX: e.clientX,
        startY: e.clientY,
        origX: n.x,
        origY: n.y,
        moved: false,
      };
    });

    window.addEventListener('pointermove', (e: PointerEvent) => {
      if (!drag) return;
      const dx = e.clientX - drag.startX;
      const dy = e.clientY - drag.startY;
      if (!drag.moved && Math.hypot(dx, dy) < 6) return;
      const n = nodes.get(drag.id);
      if (!n) {
        drag = null;
        return;
      }
      if (!drag.moved) {
        drag.moved = true;
        drag.el.classList.add('is-dragging');
      }
      const s = boardScale();
      n.x = clamp(drag.origX + dx / s, 60, 1540);
      n.y = clamp(drag.origY + dy / s, 40, 960);
      layoutNode(drag.id);
    });

    function endDrag() {
      if (!drag) return;
      const wasMoved = drag.moved;
      drag.el.classList.remove('is-dragging');
      drag = null;
      if (!wasMoved) return;
      // Persistir coordenadas
      try {
        const persist: Record<string, { x: number; y: number }> = {};
        nodes.forEach((n, id) => {
          if (n.kind !== 'hub') persist[id] = { x: Math.round(n.x), y: Math.round(n.y) };
        });
        localStorage.setItem(KEY, JSON.stringify(persist));
      } catch {
        /* almacenamiento no disponible: el drag sigue funcionando en sesión */
      }
      // El gesto fue arrastre, no clic: anular la navegación del enlace
      board!.addEventListener(
        'click',
        (ev: MouseEvent) => {
          ev.preventDefault();
          ev.stopPropagation();
        },
        { capture: true, once: true },
      );
    }
    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', () => {
      if (drag) {
        drag.el.classList.remove('is-dragging');
        drag = null;
      }
    });

    // Restablecer al mapa base
    document.getElementById('sem-reset-layout')?.addEventListener('click', () => {
      try {
        localStorage.removeItem(KEY);
      } catch {
        /* noop */
      }
      nodes.forEach((n, id) => {
        const d = defaults[id];
        if (d && n.kind !== 'hub') {
          n.x = d.x;
          n.y = d.y;
        }
      });
      nodes.forEach((n, id) => {
        if (n.kind === 'branch') layoutNode(id);
      });
    });

    // Guardar el layout actual en src/data/map-layout.ts (vía API en dev)
    // con fallback a clipboard cuando no hay servidor que escriba.
    const saveBtn = document.getElementById('sem-save-layout') as HTMLButtonElement | null;
    async function copyToClipboard(text: string): Promise<boolean> {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        try {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          const ok = document.execCommand('copy');
          ta.remove();
          return ok;
        } catch {
          return false;
        }
      }
    }
    saveBtn?.addEventListener('click', async () => {
      const branchPos: Record<string, { x: number; y: number }> = {};
      const leafPos: Record<string, { x: number; y: number }> = {};
      nodes.forEach((n, id) => {
        const p = { x: Math.round(n.x), y: Math.round(n.y) };
        if (n.kind === 'branch') branchPos[id] = p;
        else if (n.kind === 'leaf') leafPos[id] = p;
      });
      const say = (msg: string) => {
        if (!saveBtn) return;
        saveBtn.textContent = msg;
        window.setTimeout(() => {
          saveBtn.textContent = 'Guardar layout';
        }, 2600);
      };
      const layoutPayload = { branches: branchPos, leaves: leafPos };
      const toB64url = (obj: unknown) =>
        btoa(unescape(encodeURIComponent(JSON.stringify(obj))))
          .replace(/\+/g, '-')
          .replace(/\//g, '_')
          .replace(/=+$/, '');
      // 1) Intento directo: el dev server lo escribe en el JSON del proyecto
      //    (GET con payload en la URL; en preview/producción no hay servidor
      //    y se cae al clipboard).
      try {
        const res = await fetch(`/api/save-layout?d=${toB64url(layoutPayload)}`);
        if (res.ok) {
          say('¡Guardado en map-layout.ts!');
          return;
        }
      } catch {
        /* sin servidor: caemos al clipboard */
      }
      // 2) Fallback: copiar para pegado manual en src/data/map-layout.ts
      const payload =
        `export const branchPositions: Record<string, NodePosition> = ${JSON.stringify(branchPos, null, 2)};\n\n` +
        `export const leafPositions: Record<string, NodePosition> = ${JSON.stringify(leafPos, null, 2)};`;
      const ok = await copyToClipboard(payload);
      say(ok ? '¡Copiado! Pegalo en map-layout.ts' : 'No se pudo guardar');
    });
  })();
</script>
