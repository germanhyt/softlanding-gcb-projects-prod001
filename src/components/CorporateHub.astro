---
import { planetDefs } from '../data/projects.ts';

/* ── SVG icon paths (24×24, stroke-based, trazos limpios corporativos) ── */
const icons: Record<string, string> = {
  db:    `<ellipse cx="12" cy="6" rx="9" ry="3"/>
          <path d="M3 6v4c0 1.66 4 3 9 3s9-1.34 9-3V6"/>
          <path d="M3 10v4c0 1.66 4 3 9 3s9-1.34 9-3v-4"/>
          <path d="M3 14v4c0 1.66 4 3 9 3s9-1.34 9-3v-4"/>`,
  refugio:`<path d="M3 10.5L12 4l9 6.5V20a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1V10.5z"/>
          <path d="M8 21V13h8v8"/>`,
  truck: `<path d="M5 17H3a2 2 0 01-2-2V5a2 2 0 012-2h11a2 2 0 012 2v3"/>
          <polygon points="16 3 21 8 21 17 16 17 16 3"/>
          <circle cx="7" cy="17" r="2"/>
          <circle cx="17" cy="17" r="2"/>
          <line x1="9" y1="17" x2="15" y2="17"/>`,
  chart: `<rect x="2"  y="14" width="4" height="7" rx="1"/>
          <rect x="9"  y="9"  width="4" height="12" rx="1"/>
          <rect x="16" y="4"  width="4" height="17" rx="1"/>`,
  doc:   `<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="16" y1="13" x2="8" y2="13"/>
          <line x1="16" y1="17" x2="8" y2="17"/>`,
  park:  `<rect x="3" y="3" width="18" height="18" rx="2"/>
          <path d="M9 17V7h4a3 3 0 010 6H9"/>`,
  screen:`<rect x="2" y="3" width="20" height="14" rx="2"/>
          <line x1="8"  y1="21" x2="16" y2="21"/>
          <line x1="12" y1="17" x2="12" y2="21"/>`,
  play:  `<circle cx="12" cy="12" r="10"/>
          <polygon points="10 8 16 12 10 16 10 8"/>`,
  ai:    `<path d="M9.663 17h4.674M12 3v1m6.364 1.636-.707.707M21 12h-1M4 12H3m3.343-5.657-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>`,
  bal:   `<line x1="12" y1="3" x2="12" y2="21"/>
          <path d="M7 5H3l-1 9h6L7 5z"/>
          <path d="M17 5h4l1 9h-6l1-9z"/>
          <line x1="2" y1="21" x2="22" y2="21"/>`,
  cal:   `<rect x="3" y="4" width="18" height="18" rx="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>`,
};

const categories = [
  { id: 'all', label: 'Todos los sistemas', count: planetDefs.length },
  { id: 'Refugio Data', label: 'Refugio Data', count: planetDefs.filter(p => p.group === 'Refugio Data').length },
  { id: 'Sistema', label: 'Operaciones & Finanzas', count: planetDefs.filter(p => p.group === 'Sistema').length },
  { id: 'Descarga', label: 'Canales & Aplicaciones', count: planetDefs.filter(p => p.group === 'Descarga').length },
  { id: 'Herramienta', label: 'Consultas & AI', count: planetDefs.filter(p => p.group === 'Herramienta').length },
];
---

<div class="corp-container">
  <!-- ════════════════ ENCABEZADO INSTITUCIONAL ════════════════ -->
  <header class="corp-header">
    <div class="corp-header-top">
      <div class="corp-kicker">
        <span class="corp-status-indicator" aria-hidden="true"></span>
        <span>SISTEMAS OPERATIVOS · ACCESO SEGURO</span>
      </div>
      <div class="corp-env-badge">PRODUCCIÓN</div>
    </div>

    <div class="corp-header-main">
      <h1 class="corp-main-title">Directorio de Sistemas</h1>
      <p class="corp-subtitle">
        Portal oficial de acceso a las plataformas de gestión de datos, control operativo, canales de venta y herramientas analíticas de <strong>Grupo Cordillera Blanca S.A.</strong>
      </p>
    </div>

    <!-- Barra de Búsqueda y Navegación de Categorías -->
    <div class="corp-toolbar">
      <div class="corp-search-wrapper">
        <svg class="corp-search-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input
          type="text"
          id="corp-search-input"
          class="corp-search-field"
          placeholder="Buscar por nombre, descripción o URL (presiona '/' para buscar)..."
          autocomplete="off"
          spellcheck="false"
        />
        <kbd class="corp-search-shortcut" title="Atajo de teclado">/</kbd>
        <button id="corp-search-clear" class="corp-search-reset" aria-label="Borrar búsqueda" style="display: none;">✕</button>
      </div>

      <!-- Segmented Control de Categorías -->
      <nav class="corp-nav-tabs" role="tablist" aria-label="Filtrar por unidad de negocio">
        {categories.map((cat, idx) => (
          <button
            class={`corp-tab-btn ${idx === 0 ? 'is-active' : ''}`}
            data-group={cat.id}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
          >
            <span class="corp-tab-text">{cat.label}</span>
            <span class="corp-tab-badge">{cat.count}</span>
          </button>
        ))}
      </nav>
    </div>
  </header>

  <!-- ════════════════ GRID DE SISTEMAS CORPORATIVOS ════════════════ -->
  <main class="corp-main">
    <div class="corp-list-meta">
      <span class="corp-meta-label">APLICACIONES ACTIVAS</span>
      <span class="corp-meta-count" id="corp-results-count">{planetDefs.length} servicios disponibles</span>
    </div>

    <div class="corp-directory-grid" id="corp-grid-container">
      {planetDefs.map((item) => (
        <article
          class="corp-entry"
          data-group={item.group}
          data-search={`${item.full} ${item.label} ${item.desc} ${item.domain || ''} ${item.badge || ''} ${item.tag || ''}`.toLowerCase()}
        >
          <div class="corp-entry-inner">
            <!-- Entry Header -->
            <div class="corp-entry-head">
              <div class="corp-entry-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[item.icon]} />
              </div>
              <div class="corp-entry-tags">
                <span class="corp-tag-group">{item.group}</span>
                <span class="corp-tag-status">
                  <span class="corp-dot-green"></span>
                  {item.tag || 'Activo'}
                </span>
              </div>
            </div>

            <!-- Entry Content -->
            <div class="corp-entry-body">
              <h2 class="corp-entry-title">
                <a href={item.href} target="_blank" rel="noopener noreferrer" class="corp-entry-link">
                  {item.full}
                </a>
              </h2>
              <p class="corp-entry-desc">{item.desc}</p>
            </div>

            <!-- Entry Footer -->
            <div class="corp-entry-foot">
              <div class="corp-entry-url" title={`Destino: ${item.domain || 'gcbprojects.site'}`}>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                <span>{item.domain || 'gcbprojects.site'}</span>
              </div>
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="corp-action-link"
                aria-label={`Abrir plataforma ${item.full}`}
              >
                <span>Ingresar</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="7" y1="17" x2="17" y2="7"/>
                  <polyline points="7 7 17 7 17 17"/>
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty State -->
    <div id="corp-no-results" class="corp-no-results" style="display: none;">
      <p class="corp-no-results-msg">No se encontraron sistemas coincidentes con tu búsqueda.</p>
      <button id="corp-clear-filters" class="corp-btn-secondary">Restablecer filtros</button>
    </div>
  </main>

  <!-- ════════════════ PIE INSTITUCIONAL ════════════════ -->
  <aside class="corp-summary-strip">
    <div class="corp-summary-col">
      <span class="corp-summary-label">ORGANIZACIÓN</span>
      <span class="corp-summary-data">Grupo Cordillera Blanca S.A.</span>
    </div>
    <div class="corp-summary-col">
      <span class="corp-summary-label">INFRAESTRUCTURA</span>
      <span class="corp-summary-data">Cloud VPS & Microservicios</span>
    </div>
    <div class="corp-summary-col">
      <span class="corp-summary-label">SEGURIDAD</span>
      <span class="corp-summary-data">SSL / TLS 1.3 Encriptado</span>
    </div>
    <div class="corp-summary-col">
      <span class="corp-summary-label">TOTAL SISTEMAS</span>
      <span class="corp-summary-data">{planetDefs.length} Plataformas Activas</span>
    </div>
  </aside>
</div>

<style>
/* ── Corporate Container ────────────────────────────── */
.corp-container {
  max-width: 1240px;
  margin: 0 auto;
  padding: 2.5rem 1.5rem 4rem;
  display: flex;
  flex-direction: column;
  gap: 2.25rem;
}

/* ── Corporate Header ──────────────────────────────── */
.corp-header {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid var(--border);
}

.corp-header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.corp-kicker {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--fb);
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: var(--muted);
  text-transform: uppercase;
}

.corp-status-indicator {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background-color: #15803D; /* Verde bosque corporativo sobrio */
}

.corp-env-badge {
  font-family: monospace;
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--muted);
  background: var(--surface);
  border: 1px solid var(--border);
  padding: 0.2rem 0.55rem;
  border-radius: 4px;
}

.corp-header-main {
  max-width: 780px;
}

.corp-main-title {
  font-family: var(--fd);
  font-size: clamp(1.85rem, 3.2vw, 2.6rem);
  font-weight: 700;
  line-height: 1.15;
  color: var(--text);
  letter-spacing: -0.02em;
  margin: 0 0 0.6rem;
}

.corp-subtitle {
  font-family: var(--fb);
  font-size: 0.95rem;
  line-height: 1.6;
  color: var(--muted);
  margin: 0;
}

.corp-subtitle strong {
  color: var(--text);
  font-weight: 600;
}

/* ── Toolbar: Search & Segmented Navigation ─────────── */
.corp-toolbar {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin-top: 0.5rem;
}

@media (min-width: 900px) {
  .corp-toolbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
}

.corp-search-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  flex: 1;
  max-width: 460px;
}

.corp-search-svg {
  position: absolute;
  left: 0.95rem;
  color: var(--muted);
  pointer-events: none;
}

.corp-search-field {
  width: 100%;
  height: 42px;
  padding: 0 2.8rem 0 2.6rem;
  font-family: var(--fb);
  font-size: 0.85rem;
  color: var(--text);
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
  outline: none;
  transition: border-color 0.15s ease, background-color 0.15s ease;
}

.corp-search-field:focus {
  border-color: var(--gold);
}

.corp-search-field::placeholder {
  color: var(--dim);
}

.corp-search-shortcut {
  position: absolute;
  right: 0.85rem;
  font-family: monospace;
  font-size: 0.72rem;
  color: var(--muted);
  background: var(--card-bg);
  border: 1px solid var(--border);
  padding: 0.1rem 0.4rem;
  border-radius: 4px;
  pointer-events: none;
}

.corp-search-reset {
  position: absolute;
  right: 0.75rem;
  width: 22px;
  height: 22px;
  border-radius: 4px;
  background: var(--border);
  border: none;
  color: var(--text);
  font-size: 0.7rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Nav Tabs (Corporate Segmented Control) */
.corp-nav-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.corp-tab-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.45rem 0.85rem;
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: 6px;
  color: var(--muted);
  font-family: var(--fb);
  font-size: 0.78rem;
  font-weight: 500;
  cursor: pointer;
  transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
}

.corp-tab-btn:hover {
  color: var(--text);
  border-color: var(--gold-border);
}

.corp-tab-btn.is-active {
  background-color: var(--text);
  color: var(--bg);
  border-color: var(--text);
  font-weight: 600;
}

.corp-tab-badge {
  font-size: 0.68rem;
  padding: 0.1rem 0.35rem;
  border-radius: 4px;
  background: rgba(0,0,0,0.08);
}
.corp-tab-btn.is-active .corp-tab-badge {
  background: rgba(255,255,255,0.2);
}

/* ── Main Section ──────────────────────────────────── */
.corp-main {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.corp-list-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 0.5rem;
}

.corp-meta-label {
  font-family: var(--fb);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--muted);
}

.corp-meta-count {
  font-family: var(--fb);
  font-size: 0.75rem;
  color: var(--dim);
}

/* ── Corporate Grid ────────────────────────────────── */
.corp-directory-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  gap: 1rem;
}

@media (min-width: 1024px) {
  .corp-directory-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

/* ── Corporate Entry Card (Clean, Sharp, Non-AI) ──── */
.corp-entry {
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
  transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
}

.corp-entry:hover {
  border-color: var(--gold);
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
}

.corp-entry-inner {
  padding: 1.35rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100%;
  gap: 1.15rem;
}

/* Entry Head */
.corp-entry-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.corp-entry-icon {
  width: 38px;
  height: 38px;
  border-radius: 8px;
  background-color: var(--card-bg);
  border: 1px solid var(--border);
  color: var(--gold);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.corp-entry-icon svg {
  width: 20px;
  height: 20px;
}

.corp-entry-tags {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.corp-tag-group {
  font-family: var(--fb);
  font-size: 0.65rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--muted);
  background-color: var(--card-bg);
  border: 1px solid var(--border);
  padding: 0.18rem 0.5rem;
  border-radius: 4px;
}

.corp-tag-status {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.65rem;
  font-weight: 500;
  color: var(--muted);
}

.corp-dot-green {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background-color: #15803D;
}

/* Entry Body */
.corp-entry-body {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.corp-entry-title {
  font-family: var(--fd);
  font-size: 1.05rem;
  font-weight: 700;
  line-height: 1.3;
  margin: 0;
  color: var(--text);
}

.corp-entry-link {
  color: inherit;
  text-decoration: none;
  transition: color 0.15s ease;
}

.corp-entry:hover .corp-entry-link {
  color: var(--gold);
}

.corp-entry-desc {
  font-family: var(--fb);
  font-size: 0.8rem;
  line-height: 1.5;
  color: var(--muted);
  margin: 0;
}

/* Entry Foot */
.corp-entry-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid var(--border);
  padding-top: 0.85rem;
  margin-top: auto;
}

.corp-entry-url {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-family: monospace;
  font-size: 0.7rem;
  color: var(--dim);
}

.corp-action-link {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-family: var(--fb);
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--text);
  background-color: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 0.35rem 0.75rem;
  text-decoration: none;
  transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
}

.corp-action-link:hover {
  background-color: var(--gold);
  border-color: var(--gold);
  color: #0A0A0A;
}

/* ── No Results State ──────────────────────────────── */
.corp-no-results {
  padding: 3rem 1.5rem;
  text-align: center;
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
}

.corp-no-results-msg {
  font-family: var(--fb);
  font-size: 0.9rem;
  color: var(--muted);
  margin: 0;
}

.corp-btn-secondary {
  font-family: var(--fb);
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--text);
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 0.5rem 1rem;
  cursor: pointer;
  transition: border-color 0.15s ease;
}
.corp-btn-secondary:hover {
  border-color: var(--gold);
}

/* ── Institutional Summary Strip (Sober footer info) ─ */
.corp-summary-strip {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.25rem;
  padding: 1.5rem;
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
}

@media (min-width: 768px) {
  .corp-summary-strip {
    grid-template-columns: repeat(4, 1fr);
  }
}

.corp-summary-col {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.corp-summary-label {
  font-family: var(--fb);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--muted);
}

.corp-summary-data {
  font-family: var(--fd);
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--text);
}
</style>

<!-- ════════════════ SCRIPT CLIENTE (FILTROS Y BÚSQUEDA) ════════════════ -->
<script>
  function setupCorporateDirectory() {
    const input = document.getElementById('corp-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('corp-search-clear') as HTMLButtonElement | null;
    const tabButtons = document.querySelectorAll('.corp-tab-btn');
    const cards = document.querySelectorAll('.corp-entry') as NodeListOf<HTMLElement>;
    const counter = document.getElementById('corp-results-count');
    const emptyView = document.getElementById('corp-no-results');
    const resetBtn = document.getElementById('corp-clear-filters');

    let activeGroup = 'all';
    let term = '';

    function applyFilter() {
      let count = 0;

      cards.forEach((card) => {
        const grp = card.getAttribute('data-group') || '';
        const searchBlob = card.getAttribute('data-search') || '';

        const groupMatch = activeGroup === 'all' || grp === activeGroup;
        const searchMatch = !term || searchBlob.includes(term);

        if (groupMatch && searchMatch) {
          card.style.display = 'block';
          count++;
        } else {
          card.style.display = 'none';
        }
      });

      if (counter) {
        counter.textContent = `${count} ${count === 1 ? 'servicio disponible' : 'servicios disponibles'}`;
      }

      if (emptyView) {
        emptyView.style.display = count === 0 ? 'flex' : 'none';
      }
    }

    input?.addEventListener('input', (e) => {
      term = (e.target as HTMLInputElement).value.trim().toLowerCase();
      if (clearBtn) {
        clearBtn.style.display = term ? 'flex' : 'none';
      }
      applyFilter();
    });

    clearBtn?.addEventListener('click', () => {
      if (input) {
        input.value = '';
        term = '';
        clearBtn.style.display = 'none';
        input.focus();
        applyFilter();
      }
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== input) {
        e.preventDefault();
        input?.focus();
        input?.select();
      }
    });

    tabButtons.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabButtons.forEach((t) => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');

        activeGroup = tab.getAttribute('data-group') || 'all';
        applyFilter();
      });
    });

    resetBtn?.addEventListener('click', () => {
      if (input) input.value = '';
      term = '';
      activeGroup = 'all';

      tabButtons.forEach((t, i) => {
        t.classList.toggle('is-active', i === 0);
        t.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
      });

      if (clearBtn) clearBtn.style.display = 'none';
      applyFilter();
    });
  }

  setupCorporateDirectory();
  document.addEventListener('astro:page-load', setupCorporateDirectory);
</script>
